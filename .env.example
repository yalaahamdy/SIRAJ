# ==========================================
# SIRAJ BOT RUNTIME ENVIRONMENT TEMPLATE
# (SYNTHETIC / TEST CONFIGURATION ONLY)
# ==========================================
# WARNING: NEVER COMMIT REAL PRODUCTION SECRETS

# Environment Selection: local | development | test | staging | production
SIRAJ_ENVIRONMENT=local

# API Server Configuration
SIRAJ_API_HOST=127.0.0.1
SIRAJ_API_PORT=8080
SIRAJ_API_BASE_URL=http://127.0.0.1:8080

# Security & Webhook Secrets (Synthetic Test Keys Only)
SIRAJ_WEBHOOK_SECRET=siraj_test_sandbox_webhook_secret_key
SIRAJ_TELEGRAM_SECRET_TOKEN=siraj_test_telegram_sandbox_token
SIRAJ_WHATSAPP_APP_SECRET=siraj_test_whatsapp_sandbox_secret

# LLM & AI Core Settings (Local/Mock Only)
SIRAJ_LLM_PROVIDER=mock
SIRAJ_LLM_MAX_TOKENS=1000
SIRAJ_LLM_STRICT_GROUNDING=true

# Storage & Cache (In-Memory for Sandbox)
SIRAJ_DATABASE_DRIVER=memory
SIRAJ_REDIS_ENABLED=false

# Rate Limiting & Quotas
SIRAJ_RATE_LIMIT_USER_RPM=30
SIRAJ_RATE_LIMIT_CHANNEL_RPM=300
SIRAJ_MAX_PAYLOAD_SIZE_BYTES=2097152

# Logging & Privacy
SIRAJ_LOG_LEVEL=info
SIRAJ_LOG_REDACTION_ENABLED=true
